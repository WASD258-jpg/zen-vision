# 主源（必填）：优先使用，模型较新
VISION_API_KEY=
VISION_BASE_URL=https://opencode.ai/zen/v1
VISION_MODEL=mimo-v2.5-free

# 备用源（可选）：主源失败/限流/超时自动切换，防单点故障
FALLBACK_API_KEY=
FALLBACK_BASE_URL=https://open.bigmodel.cn/api/paas/v4
FALLBACK_MODEL=glm-4.1v-thinking-flash

# 更多备用源（自选，预留位置）：填了自动进 fallback 链，可继续加 VISION4_*/VISION5_*...
# VISION3_API_KEY=
# VISION3_BASE_URL=
# VISION3_MODEL=

# 输出语言：zh = 中文（默认），en = English
LANG=zh
